# Copy to .env.local (gitignored) and fill in. Vite exposes only VITE_* vars to the app.
#
# Supabase project URL and the anon (publishable) key. Both ship in the public
# bundle; that is expected, RLS + RPC-only writes are what protect the data.
# NEVER put the service_role key or an sb_secret_ key anywhere in this repo.
# Leave these empty to build a local-only app with no accounts UI.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RPC tests only (npm run test:rpc). No VITE_ prefix, so never in the bundle.
# Three confirmed users with passwords (Auth -> Users -> Add user, auto-confirm),
# ideally in a separate test project so test runs don't appear on real boards.
SUPABASE_TEST_A_EMAIL=
SUPABASE_TEST_A_PASSWORD=
SUPABASE_TEST_B_EMAIL=
SUPABASE_TEST_B_PASSWORD=
SUPABASE_TEST_C_EMAIL=
SUPABASE_TEST_C_PASSWORD=
