# Playwright builds with `--mode e2e`, which loads this file over .env.local.
# A fake Supabase that can never resolve (.invalid TLD): e2e tests mock it with
# page.route, and can never touch a real project. Only these two constants
# differ from the shipped bundle.
VITE_SUPABASE_URL=https://e2e.supabase.invalid
VITE_SUPABASE_ANON_KEY=e2e-fake-anon-key
